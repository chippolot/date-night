# Copy to .env (gitignored) for local development.

# CARTO basemaps key for the map tiles. Use a key restricted to localhost here;
# the deployed site gets its own key (restricted to chippolot.github.io) from the
# CARTO_KEY repo secret. Without a key the map still loads tiles, just unkeyed.
CARTO_KEY=

# Eventbrite private token (Account Settings → Developer Links → API Keys) for the Substation
# scraper. CI reads it from the EVENTBRITE_TOKEN repo secret. Without it that source fails.
EVENTBRITE_TOKEN=
