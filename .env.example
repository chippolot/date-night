# Copy to .env (gitignored) for local development.

# CARTO basemaps key for the map tiles. Use a key restricted to localhost here;
# the deployed site gets its own key (restricted to chippolot.github.io) from the
# CARTO_KEY repo secret. Without a key the map still loads tiles, just unkeyed.
CARTO_KEY=

# Eventbrite private token (Account Settings → Developer Links → API Keys) for the Substation
# scraper. CI reads it from the EVENTBRITE_TOKEN repo secret. Without it that source fails.
EVENTBRITE_TOKEN=

# Meta app (developers.facebook.com → your app → App settings → Basic) and a user token from the
# Graph API Explorer with instagram_basic, instagram_manage_insights, pages_show_list, and
# pages_read_engagement. `bun run meta-token` swaps a short-lived token for a 60-day one in .env.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=

# Anthropic API key for reading event flyers in Instagram posts (scripts/ig-flyers.ts and
# `bun run ig-flyers-eval`).
ANTHROPIC_API_KEY=
